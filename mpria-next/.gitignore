# Local environment. Never commit these: the compose stack's defaults are development-only
# credentials and a real deployment supplies its own.
.env
.env.local
*.local.yaml

# Local Claude Code state. .claude/settings.json IS committed — it is the shared permission
# policy for the agent team — but personal overrides are not.
.claude/settings.local.json
.claude/state/
