{
  "realm": "mpria",
  "displayName": "MpRIA Next (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,

  "roles": {
    "realm": [
      { "name": "mpria-user", "description": "May read and catalogue records." },
      { "name": "mpria-config-admin", "description": "May edit configuration drafts in config-service." },
      { "name": "mpria-config-publisher", "description": "May publish a configuration revision." }
    ]
  },

  "clients": [
    {
      "clientId": "mpria-web",
      "name": "Operator client (Next.js generic renderer)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_unit_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_unit_id",
            "claim.name": "org_unit_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mpria-admin-console",
      "name": "Configuration admin console (layout designer)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["http://localhost:3002"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_unit_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_unit_id",
            "claim.name": "org_unit_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mpria-dev-cli",
      "name": "Development CLI — password grant, for curl and smoke tests only",
      "description": "Direct access grants are enabled here and NOWHERE else. Never create this client in a real deployment.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_unit_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_unit_id",
            "claim.name": "org_unit_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "curator",
      "email": "curator@example.org",
      "firstName": "Camille",
      "lastName": "Curator",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "org_unit_id": ["33333333-3333-3333-3333-333333333333"]
      },
      "credentials": [{ "type": "password", "value": "curator", "temporary": false }],
      "realmRoles": ["mpria-user"]
    },
    {
      "username": "configadmin",
      "email": "configadmin@example.org",
      "firstName": "Sam",
      "lastName": "Steward",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "org_unit_id": ["33333333-3333-3333-3333-333333333333"]
      },
      "credentials": [{ "type": "password", "value": "configadmin", "temporary": false }],
      "realmRoles": ["mpria-user", "mpria-config-admin", "mpria-config-publisher"]
    },
    {
      "username": "reader",
      "email": "reader@example.org",
      "firstName": "Robin",
      "lastName": "Reader",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "org_unit_id": ["33333333-3333-3333-3333-333333333333"]
      },
      "credentials": [{ "type": "password", "value": "reader", "temporary": false }],
      "realmRoles": ["mpria-user"]
    }
  ]
}
