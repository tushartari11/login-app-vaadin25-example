<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings that resolve straight from Maven Central.

  The developer machine's ~/.m2/settings.xml mirrors everything through
  nexus.zetcom.group, which is only reachable on the corporate VPN. This file lets the
  greenfield build run off-VPN without modifying global tooling:

      mvn -s .mvn/settings-central.xml clean verify

  On VPN, prefer the corporate Nexus (drop the -s flag) so artifacts stay proxied and
  auditable. This file is a convenience for local development, not the CI configuration.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <localRepository>${user.home}/.m2/repository</localRepository>

    <profiles>
        <profile>
            <id>central-direct</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>central-direct</activeProfile>
    </activeProfiles>
</settings>
