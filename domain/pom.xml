<?xml version="1.0" encoding="UTF-8"?>
<!--
  DOMAIN: the heart of the system. Pure Java 21, ZERO framework dependencies.
  Entities, value objects (records), aggregates, domain events, domain services,
  and repository PORTS (interfaces such as UserRepository, PasswordHasher).
  An ArchUnit test in this module fails the build if Jakarta, Vaadin, Spring,
  JDBC or SLF4J ever leak in.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>vaadin-payara-app-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app-domain</artifactId>
  <packaging>jar</packaging>
  <name>App :: Domain</name>

  <!-- Intentionally no compile dependencies. -->
  <dependencies>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
